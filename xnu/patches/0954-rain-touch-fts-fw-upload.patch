+static bool
+touch_fts_fw_valid(vm_offset_t fw, unsigned len)
+{
+	if (!fw || len < FTS_FW_MIN_LEN || len > FTS_FW_MAX_LEN) {
+		return false;
+	}
+	volatile uint8_t *p = (volatile uint8_t *)fw;
+	unsigned code_len = ((unsigned)p[FTS_APP_INFO_OFFSET] << 8) |
+	    p[FTS_APP_INFO_OFFSET + 1];
+	unsigned code_len_n = ((unsigned)p[FTS_APP_INFO_OFFSET + 2] << 8) |
+	    p[FTS_APP_INFO_OFFSET + 3];
+	if ((code_len + code_len_n) != 0xffffu ||
+	    code_len < FTS_FW_MIN_LEN || code_len > len) {
+		return false;
+	}
+	return true;
+}
+
+static void
+touch_fts_reset_to_boot(void)
+{
+	touch_gpio(TOUCH_PIN_IRQ, 0, 3, 3, false, false);
+	touch_gpio(TOUCH_PIN_AVDD, 0, 3, 3, true, true);
+	touch_gpio(TOUCH_PIN_RESET, 0, 3, 3, true, false);
+	touch_wait(1);
+	touch_gpio(TOUCH_PIN_RESET, 0, 3, 3, true, true);
+}
+
+static bool
+touch_fts_boot_id(void)
+{
+	uint8_t id[2] = { 0, 0 };
+	int err = touch_fts_read(FTS_CMD_READ_ID, id, 2);
+	if (!err &&
+	    ((id[0] == 0x86u && (id[1] == 0x32u || id[1] == 0x42u)) ||
+	    (id[0] == 0xf0u && id[1] == 0xc6u))) {
+		return true;
+	}
+	printf("SWEET TOUCH: boot id %02x:%02x err=%d\n", id[0], id[1], err);
+	return false;
+}
+
+static bool
+touch_fts_enter_boot(void)
+{
+	for (unsigned i = 0; i < FTS_BOOT_LOOP; ++i) {
+		touch_fts_reset_to_boot();
+		touch_wait(12);
+		for (unsigned j = 0; j < FTS_BOOT_ID_TRIES; ++j) {
+			uint8_t cmd = FTS_CMD_START1;
+			if (!touch_fts_write(&cmd, 1)) {
+				touch_wait(12);
+				if (touch_fts_boot_id()) {
+					printf("SWEET TOUCH: fw boot id pass (retry %u)\n", i);
+					return true;
+				}
+			}
+			if (st.dead) {
+				return false;
+			}
+		}
+	}
+	printf("SWEET TOUCH: fw enter boot failed\n");
+	return false;
+}
+
+static bool
+touch_fts_pram_write(vm_offset_t fw, unsigned len)
+{
+	volatile uint8_t *src = (volatile uint8_t *)fw;
+	uint8_t cmd[4];
+	uint8_t buf[1 + FTS_FW_CHUNK];
+	unsigned chunks = (len + FTS_FW_CHUNK - 1u) / FTS_FW_CHUNK;
+
+	printf("SWEET TOUCH: fw pram write %u bytes, %u chunks\n", len, chunks);
+	for (unsigned off = 0; off < len; off += FTS_FW_CHUNK) {
+		unsigned n = len - off;
+		if (n > FTS_FW_CHUNK) {
+			n = FTS_FW_CHUNK;
+		}
+		cmd[0] = FTS_ROMBOOT_CMD_SET_PRAM_ADDR;
+		cmd[1] = (uint8_t)(off >> 16);
+		cmd[2] = (uint8_t)(off >> 8);
+		cmd[3] = (uint8_t)off;
+		if (touch_fts_write(cmd, sizeof(cmd))) {
+			printf("SWEET TOUCH: fw set pram addr %u failed\n", off);
+			return false;
+		}
+		buf[0] = FTS_ROMBOOT_CMD_WRITE;
+		for (unsigned j = 0; j < n; ++j) {
+			buf[1 + j] = src[off + j];
+		}
+		if (touch_fts_write(buf, n + 1u)) {
+			printf("SWEET TOUCH: fw write chunk %u failed\n", off / FTS_FW_CHUNK);
+			return false;
+		}
+	}
+	return true;
+}
+
+static uint16_t
+touch_fts_ecc(vm_offset_t fw, unsigned len)
+{
+	volatile uint8_t *p = (volatile uint8_t *)fw;
+	uint16_t ecc = 0;
+	for (unsigned i = 0; i + 1 < len; i += 2) {
+		ecc ^= (uint16_t)(((uint16_t)p[i] << 8) | p[i + 1]);
+		for (unsigned j = 0; j < 16; ++j) {
+			ecc = (ecc & 1u) ? (uint16_t)((ecc >> 1) ^ 0x8408u) :
+			    (uint16_t)(ecc >> 1);
+		}
+	}
+	return ecc;
+}
+
+static bool
+touch_fts_ecc_tp(unsigned saddr, unsigned len, uint16_t *out)
+{
+	uint8_t cmd[7] = {
+		FTS_ROMBOOT_CMD_ECC,
+		(uint8_t)(saddr >> 16), (uint8_t)(saddr >> 8), (uint8_t)saddr,
+		(uint8_t)(len >> 16), (uint8_t)(len >> 8), (uint8_t)len
+	};
+	if (touch_fts_write(cmd, sizeof(cmd))) {
+		printf("SWEET TOUCH: fw ecc cmd failed\n");
+		return false;
+	}
+	touch_wait(2);
+	uint8_t v = 0;
+	unsigned i;
+	for (i = 0; i < 100; ++i) {
+		if (!touch_fts_read(FTS_ROMBOOT_CMD_ECC_FINISH, &v, 1) &&
+		    v == FTS_ECC_OK) {
+			break;
+		}
+		touch_wait(1);
+	}
+	if (i >= 100) {
+		printf("SWEET TOUCH: fw ecc finish timeout %02x\n", v);
+		return false;
+	}
+	uint8_t e[2] = { 0, 0 };
+	if (touch_fts_read(FTS_ROMBOOT_CMD_ECC_READ, e, 2)) {
+		printf("SWEET TOUCH: fw ecc read failed\n");
+		return false;
+	}
+	*out = (uint16_t)(((uint16_t)e[0] << 8) | e[1]);
+	return true;
+}
+
+static bool
+touch_fts_upload(vm_offset_t fw, unsigned len)
+{
+	volatile uint8_t *p = (volatile uint8_t *)fw;
+	unsigned code_len = ((unsigned)p[FTS_APP_INFO_OFFSET] << 8) |
+	    p[FTS_APP_INFO_OFFSET + 1];
+
+	if (!touch_fts_fw_valid(fw, len)) {
+		printf("SWEET TOUCH: fw header invalid\n");
+		return false;
+	}
+	printf("SWEET TOUCH: fw upload len=%u app=%u\n", len, code_len);
+	if (!touch_fts_enter_boot()) {
+		return false;
+	}
+	if (!touch_fts_pram_write(fw, code_len)) {
+		return false;
+	}
+	uint16_t host = touch_fts_ecc(fw, code_len);
+	uint16_t tp = 0;
+	if (!touch_fts_ecc_tp(0, code_len, &tp)) {
+		return false;
+	}
+	printf("SWEET TOUCH: fw ecc host=%04x tp=%04x\n", host, tp);
+	if (host != tp) {
+		printf("SWEET TOUCH: fw ecc mismatch\n");
+		return false;
+	}
+	uint8_t cmd = FTS_ROMBOOT_CMD_START_APP;
+	if (touch_fts_write(&cmd, 1)) {
+		printf("SWEET TOUCH: fw start app failed\n");
+		return false;
+	}
+	touch_wait(100);
+	for (unsigned i = 0; i < 50; ++i) {
+		uint8_t idh = 0, idl = 0;
+		int e1 = touch_fts_read(FTS_CHIP_ID_H, &idh, 1);
+		int e2 = touch_fts_read(FTS_CHIP_ID_L, &idl, 1);
+		if (!e1 && !e2 && idh == FTS_CHIP_ID_H_VAL &&
+		    (idl == FTS_CHIP_ID_L_VAL || idl == 0x42u)) {
+			st.d_idh = idh;
+			st.d_idl = idl;
+			st.d_id1 = e1;
+			st.d_id2 = e2;
+			printf("SWEET TOUCH: fw running id %02x:%02x\n", idh, idl);
+			return true;
+		}
+		touch_wait(10);
+	}
+	printf("SWEET TOUCH: fw start verify failed\n");
+	return false;
+}
