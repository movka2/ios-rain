+/*
+ * Nearest-neighbour scale of one layer into the panel back buffer. The
+ * destination rectangle is already in panel coordinates; the source
+ * rectangle is in logical (iOS) pixels.
+ */
+static void
+sweet_blit_scaled(uint8_t *dst, uint32_t dstStride, int32_t dstW, int32_t dstH,
+    const uint8_t *src, uint32_t srcStride, int32_t sx, int32_t sy, int32_t sw, int32_t sh,
+    int32_t dx, int32_t dy, int32_t dw, int32_t dh)
+{
+	int32_t x0 = dx < 0 ? 0 : dx;
+	int32_t y0 = dy < 0 ? 0 : dy;
+	int32_t x1 = dx + dw;
+	int32_t y1 = dy + dh;
+
+	if (x1 > dstW) {
+		x1 = dstW;
+	}
+	if (y1 > dstH) {
+		y1 = dstH;
+	}
+	if (x1 <= x0 || y1 <= y0 || sw <= 0 || sh <= 0 || dw <= 0 || dh <= 0) {
+		return;
+	}
+	uint64_t xstep = ((uint64_t)sw << 16) / (uint32_t)dw;
+	uint64_t ystep = ((uint64_t)sh << 16) / (uint32_t)dh;
+	uint64_t yf = (uint64_t)(y0 - dy) * (uint32_t)sh * 65536 / (uint32_t)dh;
+
+	for (int32_t y = y0; y < y1; y++, yf += ystep) {
+		int32_t syy = sy + (int32_t)(yf >> 16);
+		if (syy < sy) {
+			syy = sy;
+		}
+		if (syy >= sy + sh) {
+			syy = sy + sh - 1;
+		}
+		const uint8_t *srow = src + (uint64_t)syy * srcStride;
+		uint32_t *drow = (uint32_t *)(dst + (uint64_t)y * dstStride);
+		uint64_t xf = (uint64_t)(x0 - dx) * (uint32_t)sw * 65536 / (uint32_t)dw;
+		for (int32_t x = x0; x < x1; x++, xf += xstep) {
+			int32_t sxx = sx + (int32_t)(xf >> 16);
+			if (sxx < sx) {
+				sxx = sx;
+			}
+			if (sxx >= sx + sw) {
+				sxx = sx + sw - 1;
+			}
+			drow[x] = *(const uint32_t *)(srow + (uint64_t)sxx * 4);
+		}
+	}
+}
