+/*
+ * Bring-up stage indicator: a column of white blocks at the right edge of
+ * the boot framebuffer.  It survives console text and a hung kernel, so a
+ * photo shows the last stage reached even when the console stops updating.
+ */
+#define STAGE_FB_PA   0x5c000000u
+#define STAGE_FB_W    720u
+static volatile uint32_t *stage_fb;
+
+static void
+stage_init(void)
+{
+	if (stage_fb == NULL) {
+		stage_fb = (volatile uint32_t *)ml_io_map(STAGE_FB_PA, 0x100000);
+	}
+}
+
+static void
+stage_mark(unsigned n)
+{
+	stage_init();
+	if (stage_fb == NULL) {
+		return;
+	}
+	for (unsigned i = 0; i < n && i < 20; ++i) {
+		unsigned y0 = 8u + i * 28u;
+		unsigned x0 = STAGE_FB_W - 40u;
+		for (unsigned y = y0; y < y0 + 20u; ++y) {
+			for (unsigned x = x0; x < x0 + 30u; ++x) {
+				stage_fb[y * STAGE_FB_W + x] = 0xffffffffu;
+			}
+		}
+	}
+}
